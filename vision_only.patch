@@ -946,6 +946,30 @@ class SerializedDOMState:
 
 		include_attributes = include_attributes or DEFAULT_INCLUDE_ATTRIBUTES
 
+		# VISION-ONLY MODE: when BROWSER_USE_VISION_ONLY is set, expose ONLY form-field
+		# elements (input/select/textarea) with their indices so index-based typing still
+		# works, and omit every other interactive element. The model must then locate all
+		# clickable targets visually in the (clean) screenshot and act by pixel coordinates.
+		import os as _os
+
+		if _os.environ.get('BROWSER_USE_VISION_ONLY', '').strip().lower() in ('1', 'true', 'yes', 'on'):
+			_FORM_TAGS = {'input', 'select', 'textarea'}
+			_SHOW_ATTRS = ('type', 'name', 'placeholder', 'aria-label', 'value', 'role', 'id')
+			_lines: list[str] = []
+			for _idx, _node in self.selector_map.items():
+				if _node.tag_name not in _FORM_TAGS:
+					continue
+				_attrs = _node.attributes or {}
+				_shown = ' '.join(f'{_k}={_attrs[_k]!r}' for _k in _SHOW_ATTRS if _k in _attrs)
+				_lines.append(f'[{_idx}]<{_node.tag_name} {_shown}/>')
+			_header = (
+				'VISION-ONLY MODE. The list below contains ONLY form fields (use their [index] with input_text to type). '
+				'No other interactive elements are listed: locate every clickable target visually in the screenshot and click by pixel coordinates (coordinate_x, coordinate_y).'
+			)
+			if not _lines:
+				return _header + '\nNo form fields detected on this page.'
+			return _header + '\n' + '\n'.join(_lines)
+
 		return DOMTreeSerializer.serialize_tree(self._root, include_attributes)
 
